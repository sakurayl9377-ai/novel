{
  "name": "novel-interaction-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interaction service for the Flutter novel/manga/anime app.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "smoke": "node src/smoke-test.js",
    "test": "node --import=./src/test-env.js --test --test-concurrency=1 \"src/*.test.js\"",
    "test:ai-novels": "node src/ai-novel-test.js",
    "prewarm:video-covers": "node scripts/prewarm-video-home-covers.js",
    "security": "node src/security-test.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "nodemailer": "^9.0.1",
    "ws": "^8.21.0"
  }
}
