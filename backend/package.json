{
  "name": "novel-interaction-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interaction service for the Flutter novel/manga/anime app.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "admin:dev": "vite --config admin-ui/vite.config.ts",
    "admin:build": "vite build --config admin-ui/vite.config.ts",
    "admin:typecheck": "vue-tsc --noEmit -p admin-ui/tsconfig.json",
    "admin:test": "vitest run --config admin-ui/vitest.config.ts",
    "smoke": "node src/smoke-test.js",
    "test": "node --import=./src/test-env.js --test --test-concurrency=1 \"src/*.test.js\"",
    "test:ai-novels": "node src/ai-novel-test.js",
    "prewarm:video-covers": "node scripts/prewarm-video-home-covers.js",
    "security": "node src/security-test.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.10.0",
    "nodemailer": "^9.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "element-plus": "^2.14.3",
    "jsdom": "^29.1.1",
    "pinia": "^4.0.2",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.7"
  }
}
