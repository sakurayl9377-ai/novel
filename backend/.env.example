HOST=0.0.0.0
PORT=3010
DB_PATH=./data/interaction.sqlite
APP_RELEASE_DIR=./data/releases
TOKEN_SECRET=

# Keep /api locally. On the shared yunpan server, prefer /novel-api to avoid
# colliding with the existing yunpan /api backend.
API_PREFIX=/api
ADMIN_PATH=/admin
WS_CHAT_PATH=/ws/chat
WS_DANMAKU_PATH=/ws/danmaku
WS_MAX_PAYLOAD_BYTES=65536
# Disabled by default because query strings are commonly retained by proxies
# and access logs. Enable only during a time-bounded legacy client migration.
ALLOW_LEGACY_WS_QUERY_TOKEN=false
CORS_ORIGIN=*
# Comma-separated proxy IPs/CIDRs that are allowed to supply X-Forwarded-For.
TRUST_PROXY=127.0.0.1,::1
ALLOW_DEV_AUTH_CODES=false
# Local/private-network reader beta builds can use a server-created test user
# without embedding credentials in the APK. This remains disabled in
# NODE_ENV=production and rejects non-private client addresses.
ALLOW_BETA_TEST_SESSION=false

# Bailian game SSO and Sakura Coin payments. Secrets remain server-side.
BAILIAN_LAUNCH_URL=https://49.232.137.85/bailian/
BAILIAN_SSO_SHARED_SECRET=
BAILIAN_SSO_TTL_SECONDS=600
BAILIAN_PAYMENT_CATALOG_FILE=
BAILIAN_PAYMENT_CATALOG_JSON=
BAILIAN_PAYMENT_FULFILLMENT_URL=
BAILIAN_PAYMENT_HMAC_SECRET=
BAILIAN_PAYMENT_MAX_ATTEMPTS=3
BAILIAN_PAYMENT_TIMEOUT_MS=5000

# Modao game SSO and Sakura coin payments. Product prices are authoritative on
# this backend. Prices are charged at 10 Sakura coins = CNY 1.
MODAO_LAUNCH_URL=
MODAO_SSO_SHARED_SECRET=
MODAO_SSO_TTL_SECONDS=600
MODAO_PAYMENT_CATALOG_FILE=
MODAO_PAYMENT_CATALOG_JSON=
MODAO_PAYMENT_VERIFY_URL=
MODAO_PAYMENT_FULFILLMENT_URL=
MODAO_PAYMENT_HMAC_SECRET=
# Maximum automatic delivery attempts. Explicit retries remain available for
# idempotent reconciliation; ambiguous failures are never auto-refunded.
MODAO_PAYMENT_MAX_ATTEMPTS=3
MODAO_PAYMENT_TIMEOUT_MS=5000
MODAO_PAYMENT_CLAIM_TTL_MS=60000

# KDJX device authorization, long-lived revocable credentials, 60-second
# one-time login tickets, and Sakura coin payments. Keep both secrets only in
# the server environment.
KDJX_DEVICE_AUTHORIZATION_URL=sakura-novel://game/kdjx/authorize
KDJX_SSO_SHARED_SECRET=
KDJX_SESSION_TTL_DAYS=3650
KDJX_SESSION_MAX_PER_USER=10
KDJX_LOGIN_TICKET_TTL_SECONDS=60
KDJX_DEVICE_CODE_TTL_SECONDS=600
KDJX_DEVICE_POLL_INTERVAL_SECONDS=5
KDJX_PAYMENT_CATALOG_FILE=./catalogs/kdjx-payment-catalog.json
KDJX_PAYMENT_CATALOG_JSON=
KDJX_PAYMENT_VERIFY_URL=http://127.0.0.1:18080/internal/sakura/payments/verify
KDJX_PAYMENT_FULFILLMENT_URL=http://127.0.0.1:18080/internal/sakura/payments/fulfill
KDJX_PAYMENT_HMAC_SECRET=
KDJX_PAYMENT_MAX_ATTEMPTS=3
KDJX_PAYMENT_TIMEOUT_MS=5000
KDJX_PAYMENT_CLAIM_TTL_MS=60000
# GM item grants are sent only to the loopback KDJX bridge. A timed-out grant
# gets one same-request read-only reconciliation; it can never create a second
# mail. Outcomes still unknown after that are recorded for manual review.
# Use the same independent 32+ character secret as the KDJX runtime's
# KDJX_GM_HMAC_SECRET; do not reuse a payment or login secret.
KDJX_GM_DELIVERY_URL=http://127.0.0.1:18080/internal/sakura/gm/deliveries
KDJX_GM_DELIVERY_HMAC_SECRET=
KDJX_GM_DELIVERY_TIMEOUT_MS=20000

VIDEO_COVER_DIR=./data/video-covers
VIDEO_COVER_MAX_BYTES=3145728
# HLS playback is relayed only for these source-owned CDN suffixes. Numbered
# lzcdn, cdnlz, and lz-cdn host families are recognized separately in code.
VIDEO_PLAYBACK_ALLOWED_HOSTS=ppqrrs.com,adfg8.vip,lfthirtytwo.com
# The public source DNS currently resolves to 0.0.0.0. Preserve its TLS host
# while resolving the socket through the still-live legacy source hostname.
VIDEO_SOURCE_ORIGIN=https://www.xinyegdchina.com
VIDEO_SOURCE_CONNECT_HOST=www.wuhandky.com

# Wenku8 ranking pages require login. Leave username/password empty to let
# the backend create one server-only reader account and persist it under data/.
# The account file and credentials must never be shipped in the mobile app.
WENKU8_BASE_URL=https://www.wenku8.cc
WENKU8_USERNAME=
WENKU8_PASSWORD=
WENKU8_ACCOUNT_FILE=./data/wenku8-account.json
WENKU8_AUTO_REGISTER=true
WENKU8_CACHE_TTL_MS=600000
WENKU8_TIMEOUT_MS=8000

# Remote speech URLs are disabled by default. The normal flow transcribes the
# authenticated user's own chat-audio upload.
SPEECH_ALLOW_REMOTE_AUDIO=false
SPEECH_AUDIO_MAX_BYTES=5242880
SPEECH_AUDIO_TIMEOUT_MS=8000

UPLOAD_MAX_FILES_PER_USER=100
UPLOAD_MAX_BYTES_PER_USER=104857600
# Unreferenced uploads younger than this grace window remain available while a
# user is still editing a profile or composing a message.
UPLOAD_ORPHAN_GRACE_MS=86400000
UPLOAD_ORPHAN_SWEEP_INTERVAL_MS=3600000

# Used only to create the initial administrator. Existing accounts are never
# reset or unbanned during startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SMTP is required unless ALLOW_DEV_AUTH_CODES=true is explicitly enabled for
# isolated local development or tests.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Novel App <no-reply@example.com>"
