HOST=0.0.0.0
PORT=3010
DB_PATH=./data/interaction.sqlite
APP_RELEASE_DIR=./data/releases
TOKEN_SECRET=

# Keep /api locally. On the shared yunpan server, prefer /novel-api to avoid
# colliding with the existing yunpan /api backend.
API_PREFIX=/api
ADMIN_PATH=/admin
WS_CHAT_PATH=/ws/chat
WS_DANMAKU_PATH=/ws/danmaku
CORS_ORIGIN=*
# Comma-separated proxy IPs/CIDRs that are allowed to supply X-Forwarded-For.
TRUST_PROXY=127.0.0.1,::1
ALLOW_DEV_AUTH_CODES=false

# Suibian Kan catalog. The local JSON file is preferred when it exists. If it
# does not exist, an optional authenticated HTTPS endpoint can provide the same
# JSON shape. Never put the token in the mobile app.
SUIBIAN_CATALOG_FILE=./data/suibian-catalog.json
SUIBIAN_CATALOG_URL=
SUIBIAN_CATALOG_TOKEN=
SUIBIAN_CATALOG_TIMEOUT_MS=8000
SUIBIAN_CATALOG_CACHE_TTL_MS=300000
SUIBIAN_CATALOG_MAX_BYTES=5242880

# Remote speech URLs are disabled by default. The normal flow transcribes the
# authenticated user's own chat-audio upload.
SPEECH_ALLOW_REMOTE_AUDIO=false
SPEECH_AUDIO_MAX_BYTES=5242880
SPEECH_AUDIO_TIMEOUT_MS=8000

UPLOAD_MAX_FILES_PER_USER=100
UPLOAD_MAX_BYTES_PER_USER=104857600

# Used only to create the initial administrator. Existing accounts are never
# reset or unbanned during startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# SMTP is required unless ALLOW_DEV_AUTH_CODES=true is explicitly enabled for
# isolated local development or tests.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Novel App <no-reply@example.com>"
