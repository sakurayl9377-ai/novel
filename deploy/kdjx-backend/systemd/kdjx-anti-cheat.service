[Unit]
Description=KDJX anti-cheat service
After=kdjx-nsqd.service
Requires=kdjx-nsqd.service

[Service]
Type=simple
EnvironmentFile=-/etc/kdjx/runtime.env
WorkingDirectory=/opt/kdjx/runtime/current/anti-cheat
ExecStartPre=/usr/bin/env sh -c 'command -v luajit >/dev/null'
ExecStart=/opt/kdjx/runtime/current/bin/anti_cheat_server -config=agent.cn.1 -limit=1 -scripts=/opt/kdjx/runtime/current/anti-cheat-scripts
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
LimitNOFILE=65536
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=kdjx-runtime.target
