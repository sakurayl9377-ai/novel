# Copy to /etc/kdjx/runtime.env on the backend host and chmod 0600.
# This file is intentionally not a deployable credential file.

KDJX_RUNTIME_ROOT=/opt/kdjx/runtime/current
KDJX_NOVEL_API_URL=http://127.0.0.1:3010/novel-api
KDJX_SSO_SHARED_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
KDJX_PAYMENT_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
KDJX_MONGO_URI=mongodb://127.0.0.1:27159
KDJX_PYTHON_IMAGE=kdjx-legacy-python:2.7
